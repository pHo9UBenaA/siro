{
  "name": "@pho9ubenaa/siro",
  "version": "0.4.0",
  "description": "Security best-practices linter for the npm ecosystem (npm, pnpm, deno, bun, yarn, aube).",
  "keywords": [
    "aube",
    "bun",
    "cli",
    "deno",
    "hardening",
    "lint",
    "linter",
    "npm",
    "pnpm",
    "security",
    "supply-chain",
    "yarn"
  ],
  "homepage": "https://github.com/pHo9UBenaA/siro#readme",
  "bugs": {
    "url": "https://github.com/pHo9UBenaA/siro/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pHo9UBenaA/siro.git"
  },
  "bin": {
    "siro": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "node bench/lint.bench.ts",
    "build": "tsdown && node scripts/bin-wrapper.mjs",
    "check": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt --write",
    "gen": "pnpm gen:docs && pnpm gen:api",
    "gen:api": "typedoc",
    "knip": "knip",
    "prepublishOnly": "pnpm verify",
    "test": "pnpm build && vitest run",
    "test:coverage": "pnpm build && vitest run --coverage",
    "test:watch": "pnpm build && vitest",
    "typecheck": "tsc --noEmit",
    "gen:docs": "node scripts/docs.ts",
    "check:docs": "node scripts/docs.ts --check",
    "verify": "pnpm typecheck && pnpm check && pnpm knip && pnpm check:docs && pnpm test"
  },
  "dependencies": {
    "ini": "7.0.0",
    "picocolors": "1.1.1",
    "semver": "7.8.1",
    "smol-toml": "1.6.1",
    "valibot": "1.4.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@types/ini": "4.1.1",
    "@types/node": "25.9.1",
    "@types/semver": "7.7.1",
    "@vitest/coverage-v8": "4.1.7",
    "knip": "6.15.0",
    "memfs": "4.57.3",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "tinybench": "6.0.2",
    "tsdown": "0.22.1",
    "typedoc": "0.28.19",
    "typedoc-plugin-markdown": "4.11.0",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": "^22.18.0 || ^23.6.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
