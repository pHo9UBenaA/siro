{
  "name": "@pho9ubenaa/siro",
  "version": "0.4.0",
  "description": "Security best-practices linter for the npm ecosystem (npm, pnpm, deno, bun, yarn, aube).",
  "keywords": [
    "aube",
    "bun",
    "cli",
    "deno",
    "hardening",
    "lint",
    "linter",
    "npm",
    "pnpm",
    "security",
    "supply-chain",
    "yarn"
  ],
  "homepage": "https://github.com/pHo9UBenaA/siro#readme",
  "bugs": {
    "url": "https://github.com/pHo9UBenaA/siro/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pHo9UBenaA/siro.git"
  },
  "bin": {
    "siro": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "node bench/lint.bench.ts",
    "build": "tsdown && node scripts/bin-wrapper.mjs",
    "check": "oxlint --deny-warnings && oxfmt --check",
    "check:oss-coverage": "node ./oss-benchmarks/check.mjs",
    "format": "oxfmt --write",
    "gen": "pnpm gen:docs && pnpm gen:api",
    "gen:api": "typedoc",
    "knip": "knip",
    "prepublishOnly": "pnpm typecheck && pnpm build && pnpm test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:docs": "node scripts/docs.ts",
    "check:docs": "node scripts/docs.ts --check",
    "verify": "pnpm typecheck && pnpm check && pnpm knip && pnpm check:docs && pnpm build && pnpm test"
  },
  "dependencies": {
    "cac": "catalog:",
    "ini": "catalog:",
    "picocolors": "catalog:",
    "semver": "catalog:",
    "smol-toml": "catalog:",
    "valibot": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/ini": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "knip": "catalog:",
    "memfs": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tinybench": "catalog:",
    "tsdown": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^23.6.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
